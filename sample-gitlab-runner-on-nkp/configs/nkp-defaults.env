# ==============================================================================
# Config: nkp-defaults.env
# Purpose: Global default values for NKP cluster deployments.
# ==============================================================================

# Infrastructure Defaults
export NUTANIX_STORAGE_CONTAINER_NAME="SelfServiceContainer"

# Sizing Defaults
export CONTROL_PLANE_REPLICAS="1"
export WORKER_NODES_REPLICAS="2"

# Registry mirror
export REGISTRY_MIRROR_URL="registry.nutanixdemo.com/bootcamps"