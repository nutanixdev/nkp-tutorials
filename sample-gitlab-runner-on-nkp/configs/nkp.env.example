# Prism Central username for nkp clusterapi integration - avoid admin if possible
export NUTANIX_USER=nkp-user

# Keep the password enclosed between single quotes - Ex: 'password'
export NUTANIX_PASSWORD="provide-at-runtime"

# Prism Central IP address or FQDN without https://
export NUTANIX_ENDPOINT=0.0.0.0                          

# Prism Central port (default: 9440)
export NUTANIX_PORT=9440        

# NKP cluster name. When using NKP Pro/Ultimate, this name is used to generate the license key
export CLUSTER_NAME=nkp-example

# Kubernetes VIP. Must be in the same subnet as the VMs - Ex: 10.42.236.203
export CONTROL_PLANE_ENDPOINT_IP=192.168.0.1                                                 

# Load balancer IP pool. Must be in the same subnet as the VMs - Ex: 10.42.236.204-10.42.236.204
export LB_IP_RANGE=192.168.0.2-192.168.0.3                    

# NKP Rocky image name matching your NKP version
export NUTANIX_MACHINE_TEMPLATE_IMAGE_NAME=nkp-rocky-9.6-release-cis-1.34.1-20251206060914.qcow2

# Prism Element cluster name - Ex: AOS-001
export NUTANIX_PRISM_ELEMENT_CLUSTER_NAME=AOS-001

# Prism Element Subnet on which to deploy the kubernetes cluster
export NUTANIX_SUBNET_NAME=testing-subnet                            
